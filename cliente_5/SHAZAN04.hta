<html lang="pt-BR">
<head>
    <title>S.O.S TI - SHAZAM ULTRA EDITION</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <hta:application 
        id="oSosTI"
        applicationname="PainelShazamTotal"
        border="thick"
        caption="yes"
        maximizebutton="no"
        minimizebutton="yes"
        scroll="no"
        singleinstance="yes"
        windowstate="normal"
    />

    <style>
        body {
            font-family: 'Consolas', monospace;
            background-color: #05070a;
            color: #ffff00;
            margin: 20px;
            overflow: hidden;
        }
        .header {
            border: 3px double #ffff00;
            padding: 15px;
            text-align: center;
            background-color: #1a1a00;
            color: #ffff00;
            font-weight: bold;
            font-size: 22px;
            margin-bottom: 20px;
            text-shadow: 0 0 10px #ffff00;
        }
        .main-box {
            background-color: #0d1117;
            border: 2px solid #ffff00;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 0 20px rgba(255, 255, 0, 0.2);
        }
        .btn-shazam-master {
            background-color: #ffff00;
            color: #000;
            border: 2px solid #ffffff;
            padding: 20px;
            width: 100%;
            font-size: 22px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 6px;
            box-shadow: 0 0 15px #ffff00;
            transition: 0.2s;
        }
        .btn-shazam-master:hover {
            background-color: #ffcc00;
            transform: scale(1.01);
        }
        #terminal {
            background-color: #000000;
            color: #00ff66;
            padding: 15px;
            border: 1px solid #30363d;
            height: 320px;
            overflow-y: auto;
            margin-top: 20px;
            font-size: 12px;
            text-align: left;
            white-space: pre-wrap;
        }
        .alerta-adm {
            color: #00ff66;
            font-size: 11px;
            margin-top: 5px;
            font-weight: bold;
        }
    </style>

    <script language="VBScript">
        Dim shell, fso
        Set shell = CreateObject("WScript.Shell")
        Set fso = CreateObject("Scripting.FileSystemObject")

        Sub Window_OnLoad
            window.resizeTo 750, 750
            VerificarEForcarAdministrador()
        End Sub

        ' SISTEMA AUTO-ELEVADOR PARA EXECUTAR COMO ADMINISTRADOR AUTOMATICAMENTE
        Sub VerificarEForcarAdministrador()
            On Error Resume Next
            ' Tenta ler uma chave restrita do sistema para testar se ja e Admin
            shell.RegRead("HKEY_USERS\S-1-5-19\Environment\TEMP")
            
            If Err.Number <> 0 Then
                ' Se deu erro, nao e admin. Forca a reabertura oculta pedindo privilégios máximos
                Dim htaCaminho
                htaCaminho = document.location.pathname
                
                ' Executa o HTA original novamente com o parametro "runas" (Administrador)
                CreateObject("Shell.Application").ShellExecute "mshta.exe", Chr(34) & htaCaminho & Chr(34), "", "runas", 1
                ' Fecha a janela atual comum que nao tem permissao
                window.close()
            End If
            On Error GoTo 0
        End Sub

        ' ROTINA SHAZAM DE UM CLIQUE: DESTRAVA E RESOLVE TUDO SEQUENCIALMENTE
        Sub ExecutarShazamTotal()
            Dim terminalTela, fTemp, scriptMestre
            Set terminalTela = Document.GetElementById("terminal")
            
            terminalTela.InnerText = "[SHAZAM MASTER] SEJA BEM-VINDO AO MODO DEUS DO WINDOWS." & vbCrLf & _
                                     "[⚡] PRIVILÉGIOS ADMINISTRATIVOS CONFIRMADOS." & vbCrLf & _
                                     "[🚀] INICIANDO DESCONGESTIONAMENTO CRÍTICO GLOBAL..." & vbCrLf
            
            fTemp = shell.ExpandEnvironmentStrings("%TEMP%") & "\shazam_ultra.txt"
            
            ' Script mestre encadeado em linha que resolve todas as frentes de travamento
            scriptMestre = "echo [1/6] EXPURGANDO GARGALOS DE DISCO (CACHE E TEMPORARIOS)... & " & _
                           "del /f /s /q %systemroot%\temp\* >nul 2>&1 & del /f /s /q %temp%\* >nul 2>&1 & " & _
                           "echo [2/6] MATANDO PROCESSO TRAVADOS E APLICACOES EM 'NAO RESPONDENDO'... & " & _
                           "taskkill /f /fi " & Chr(34) & "STATUS eq NOT RESPONDING" & Chr(34) & " >nul 2>&1 & " & _
                           "echo [3/6] RESETANDO E SANITIZANDO PROTOCOLOS DE REDE (TCP/IP E DNS)... & " & _
                           "ipconfig /flushdns >nul & netsh int ip reset >nul & netsh winsock reset >nul & " & _
                           "echo [4/6] RECONSTRUINDO ARQUIVOS DE KERNEL DO SISTEMA OPERACIONAL... & " & _
                           "sfc /scannow & " & _
                           "echo [5/6] REPARANDO COMPONENTES DA IMAGEM DO WINDOWS (DISM)... & " & _
                           "DISM /Online /Cleanup-Image /RestoreHealth & " & _
                           "echo [6/6] ATUALIZANDO DIRETIVAS DE SEGURANCA E GP_REGISTRY... & " & _
                           "gpupdate /force >nul"

            ' Roda todo o script em background sem abrir janelas pretas do CMD na tela
            shell.Run "cmd /c " & scriptMestre & " > """ & fTemp & """ 2>&1", 0, True
            
            ' Coleta os logs estruturados e exibe na tela limpa
            If fso.FileExists(fTemp) Then
                Dim f, txt
                Set f = fso.OpenTextFile(fTemp, 1)
                If Not f.AtEndOfStream Then 
                    txt = f.ReadAll
                Else 
                    txt = "[!] Rotina executada, mas o arquivo de log retornou vazio."
                End If
                f.Close
                fso.DeleteFile(fTemp)
                
                terminalTela.InnerText = txt & vbCrLf & "--- SISTEMA 100% LIBERADO E DESTRAVADO COM SUCESSO! ---"
                
                ' Emite 3 bipes sonoros diretamente no hardware avisando a conclusao
                shell.Run "cmd /c echo " & Chr(7) & " & echo " & Chr(7) & " & echo " & Chr(7), 0, False
                MsgBox "O Windows foi completamente otimizado e os gargalos foram removidos!", 64, "SHAZAM COMPLETO"
            Else
                terminalTela.InnerText = "[!] Falha ao gerar o relatorio da operacao."
            End If
        End Sub
    </script>
</head>
<body>

    <div class="header">S.O.S TI - SISTEMA DE CLIQUE ÚNICO DE REDENÇÃO</div>

    <div class="main-box">
        <button class="btn-shazam-master" onclick="vbs:ExecutarShazamTotal()">⚡ CLIQUE AQUI: SOLUÇÃO SHAZAM TOTAL ⚡</button>
        <div class="alerta-adm">🛡️ AMBIENTE EXECUTANDO EM MODO DE ACESSO ELEVADO (SYSTEM_ADMIN)</div>
    </div>

    <div id="terminal">Aguardando gatilho do operador... Clique no botão acima para iniciar a limpeza e correção em tempo real.</div>

</body>
</html>
