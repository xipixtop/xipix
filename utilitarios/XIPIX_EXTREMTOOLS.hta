<!DOCTYPE html>
<html>
<head>
    <title>SISTEMA SUPREME PRO - Console de TI</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <hta:application 
        id="sysSupremePro"
        applicationname="Sistema Supreme Pro"
        border="thin"
        borderstyle="normal"
        caption="yes"
        maximizebutton="no"
        minimizebutton="no"
        showintaskbar="yes"
        singleinstance="yes"
        sysmenu="yes"
        windowstate="normal"
    />
    <style>
        * { box-sizing: border-box; }
        body {
            background-color: #05070a;
            color: #c9d1d9;
            font-family: 'Consolas', 'Segoe UI', monospace;
            margin: 0;
            padding: 15px;
            overflow-x: hidden;
        }
        .header {
            border-bottom: 2px dashed #00ff66;
            padding-bottom: 10px;
            margin-bottom: 15px;
            text-align: center;
        }
        h1 {
            color: #00ff66;
            font-size: 20px;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 0 8px rgba(0, 255, 102, 0.4);
        }
        .subtitle {
            color: #8b949e;
            font-size: 11px;
            margin: 5px 0 0 0;
        }
        .card {
            background: #0d1117;
            border: 1px solid #21262d;
            border-radius: 6px;
            padding: 10px;
            margin-bottom: 10px;
        }
        .card-title {
            color: #58a6ff;
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 8px;
            text-transform: uppercase;
            border-left: 3px solid #58a6ff;
            padding-left: 6px;
        }
        button {
            background-color: #161b22;
            color: #e6edf3;
            border: 1px solid #30363d;
            padding: 10px 12px;
            font-size: 12px;
            font-family: 'Segoe UI', sans-serif;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
            text-align: left;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            transition: all 0.15s ease-in-out;
        }
        button:hover {
            background-color: #21262d;
            border-color: #00ff66;
            color: #ffffff;
            box-shadow: 0 0 10px rgba(0, 255, 102, 0.15);
        }
        button:last-child { margin-bottom: 0; }
        
        /* Estilo Especial do Botão Master XIPIX */
        .btn-xipix {
            background-color: #1f1505;
            border: 1px solid #ff9900;
            color: #ffaa33;
            font-size: 13px;
            font-weight: bold;
            text-transform: uppercase;
            justify-content: center;
            letter-spacing: 1px;
        }
        .btn-xipix:hover {
            background-color: #332200;
            border-color: #ffaa00;
            color: #ffffff;
            box-shadow: 0 0 12px rgba(255, 153, 0, 0.4);
        }
        
        .icon {
            margin-right: 10px;
            font-size: 16px;
            width: 20px;
            text-align: center;
        }
        .footer {
            text-align: center;
            font-size: 10px;
            color: #8b949e;
            margin-top: 10px;
        }
    </style>
    <script language="vbscript">
        Sub Window_OnLoad
            window.resizeTo 460, 750
            window.moveTo (screen.width - 460) / 2, (screen.height - 750) / 2
            VerificarAdmin
        End Sub

        Sub VerificarAdmin
            Set objShell = CreateObject("WScript.Shell")
            On Error Resume Next
            objShell.RegRead("HKEY_USERS\S-1-5-19\Environment\")
            If Err.Number <> 0 Then
                Set objShellApp = CreateObject("Shell.Application")
                objShellApp.ShellExecute "mshta.exe", """" & window.location.pathname & """", "", "runas", 1
                window.close
            End If
            On Error GoTo 0
        End Sub

        Sub RunCMD(commands)
            Set objShell = CreateObject("WScript.Shell")
            objShell.Run "cmd.exe /c " & commands & " & echo. & echo [PROCESSO CONCLUIDO] Pressione qualquer tecla para voltar ao painel... & pause > nul", 1, True
        End Sub

        ' --- ROTINAS ISOLADAS ---
        Function GetFixRede()
            GetFixRede = "echo Corrigindo gargalos e otimizando fluxo IP... & " & _
                         "netsh int ip reset & netsh winsock reset & " & _
                         "netsh interface tcp set global autotuninglevel=normal & " & _
                         "netsh interface tcp set global congestionprovider=ctcp & " & _
                         "netsh int tcp set global dca=enabled & " & _
                         "netsh int tcp set global netdns=enabled & " & _
                         "ipconfig /flushdns & ipconfig /release & ipconfig /renew"
        End Function

        Sub FixRede
            RunCMD "title SUPREME - INTERNET, PACOTES E ROTAS & " & GetFixRede()
        End Sub

        Function GetPurgaAncoraSul()
            GetPurgaAncoraSul = "echo Executando purga completa dos caches de aplicacao e sistema... & " & _
                                "ipconfig /flushdns & nbtstat -R & nbtstat -RR & " & _
                                "arp -d * & " & _
                                "netsh int ip reset c:\resetlog.txt & " & _
                                "RunDll32.exe inetcpl.cpl,ClearMyTracksByProcess 255"
        End Function

        Sub PurgaAncoraSul
            RunCMD "title SUPREME - SANITIZACAO E LIMPEZA DE CACHE & " & GetPurgaAncoraSul()
        End Sub

        Function GetLimpezaTI()
            GetLimpezaTI = "echo Varrendo e eliminando lixo de armazenamento... & " & _
                           "del /q /f /s %temp%\* & del /q /f /s C:\Windows\Temp\* & " & _
                           "del /q /f /s C:\Windows\Prefetch\* & del /q /f /s C:\Windows\*.log & " & _
                           "del /q /f /s C:\Windows\*.dmp & del /q /f /s %userprofile%\AppData\Local\Microsoft\Windows\INetCache\*"
        End Function

        Sub LimpezaTI
            RunCMD "title SUPREME - EXPURGO DE LOGS E ARQUIVOS TEMPORARIOS & " & GetLimpezaTI()
        End Sub

        Function GetReparaSO()
            GetReparaSO = "echo Iniciando checagem estrutural profunda (DISM, SFC)... & " & _
                          "dism /online /cleanup-image /restorehealth & " & _
                          "sfc /scannow & " & _
                          "echo N | chkdsk c: /f /r"
        End Function

        Sub ReparaSO
            RunCMD "title SUPREME - DIAGNOSTICO E ESTRUTURA DO S.O. & " & GetReparaSO()
        End Sub

        Function GetAlocacaoMem()
            GetAlocacaoMem = "echo Ajustando zonas MFT e tabelas de alocacao... & " & _
                             "fsutil behavior set memoryusage 2 & " & _
                             "fsutil behavior set mftzone 2 & " & _
                             "defrag C: /O /U"
        End Function

        Sub AlocacaoMem
            RunCMD "title SUPREME - ARQUITETURA DE MEMORIA & " & GetAlocacaoMem()
        End Sub

        Function GetTurbinarCPU()
            GetTurbinarCPU = "echo Desbloqueando clock maximo e politicas de energia... & " & _
                             "powercfg -duplicatescheme e9a42b02-d5df-448d-aa00-03f14749eb61 & " & _
                             "powercfg -setactive e9a42b02-d5df-448d-aa00-03f14749eb61 & " & _
                             "reg add HKLM\SYSTEM\CurrentControlSet\Control\Power /v HighPerformance /t REG_DWORD /d 1 /f"
        End Function

        Sub TurbinarCPU
            RunCMD "title SUPREME - SINTONIA DO PROCESSADOR & " & GetTurbinarCPU()
        End Sub

        Function GetGPOActive()
            GetGPOActive = "echo Forcando atualizacao imediata do Active GPO... & " & _
                           "gpupdate /force /wait:0"
        End Function

        Sub GPOActive
            RunCMD "title SUPREME - DIRETRIZES DE GRUPO & " & GetGPOActive()
        End Sub

        ' --- MASTER BOTÃO: XIPIX COM TRAVA ---
        Sub ExecutarXipix
            Dim senha
            senha = InputBox("AÇÃO GLOBAL CONTRA-INDICADA PARA USUÁRIOS LEIGOS." & vbCrLf & vbCrLf & "Digite a credencial de liberação master para iniciar a automação completa:", "TRAVA DE SEGURANÇA XIPIX")
            
            If senha = "XIPIX" Then
                Dim cmdGlobal
                cmdGlobal = "title SUPREME PRO - AUTOMACAO MASTER GLOBAL [XIPIX] & " & _
                            "echo ============================================ & " & _
                            "echo INICIANDO MANUTENCAO TOTAL SISTEMICA [XIPIX] & " & _
                            "echo ============================================ & " & _
                            GetPurgaAncoraSul() & " & " & _
                            GetFixRede() & " & " & _
                            GetLimpezaTI() & " & " & _
                            GetAlocacaoMem() & " & " & _
                            GetTurbinarCPU() & " & " & _
                            GetGPOActive() & " & " & _
                            GetReparaSO()
                RunCMD cmdGlobal
            ElseIf senha <> "" Then
                MsgBox "Acesso negado! Chave incorreta.", 16, "Erro de Autenticação"
            End If
        End Sub
    </script>
</head>
<body>

    <div class="header">
        <h1>SISTEMA SUPREME PRO</h1>
        <div class="subtitle">Console Unificado de Resolução Técnica em TI</div>
    </div>

    <!-- Módulo Global Adicionado no Topo -->
    <div class="card" style="border-color: #ff9900;">
        <div class="card-title" style="color: #ff9900; border-left-color: #ff9900;">Automação Total</div>
        <button class="btn-xipix" onclick="vbscript:ExecutarXipix()">
